    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@swc/core": "^1.16.18",
    "@types/csurf": "^1.11.5",
    "@types/express-session": "^1.19.0",
    "@types/supertest": "^7.0.0",
