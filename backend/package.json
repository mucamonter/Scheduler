    "rxjs": "^7.8.1",
    "@nestjs/serve-static": "^12.0.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "express": "^5.3.0",
    "express-session": "^1.18.2",
    "mysql2": "^3.14.3",
    "pg": "^8.23.1"
  },
